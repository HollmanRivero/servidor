# ------------------------------------------------------------------
# Mal for backend/.env
# Kopier til ".env" på den nye maskinen (eller kjør bash deploy/install.sh):
#   cp backend/.env.example backend/.env
#
# VIKTIG: Den ekte .env-filen er i .gitignore og skal ALDRI på GitHub!
#
# VIKTIG: .env leses BARE når prosessen starter. Etter hver endring her må
# tjenesten startes på nytt, ellers kjører den videre med de gamle nøklene:
#   sudo systemctl restart servidor-super
# Sjekk med: curl -s localhost:8000/health   (se "deepseek_key_configured")
# ------------------------------------------------------------------

# Delt hemmelighet mellom mobilappen og serveren (header: "X-API-Token").
# Genereres automatisk av deploy/install.sh hvis den står tom:
#   openssl rand -hex 32
API_TOKEN=

# Gemini -> https://aistudio.google.com/apikey
# Gratisnivået har 20 forespørsler per DAG per modell
# (GenerateRequestsPerDayPerProjectPerModel-FreeTier). Når en modell er brukt opp
# gir den HTTP 429 i flere timer, så serveren setter den på pause og går videre
# til neste modell i listen. Rekkefølgen under er derfor et fallback-løp, og den
# siste (lite) er den som holder lengst.
# Pausene vises i /health -> "gemini_model_cooldowns".
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3-flash-preview,gemini-flash-latest,gemini-flash-lite-latest

# DeepSeek -> https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Tech-AI monkey -> https://tech-ai.tech/dashboard/api-keys
# Nøkkelen starter med "tai_". Tom = Tech-AI er av.
TECH_AI_API_KEY=
TECH_AI_API_URL=https://tech-ai.tech/v1/chat/completions
TECH_AI_MODEL=tech-ai-monkey

# Vercel Postgres (minne, jobber og samtalehistorikk for agenten)
# Hvis denne mangler, faller serveren tilbake til lokal SQLite (backend/data/memory.db).
# DATABASE_URL=postgres://default:xxx@ep-xxx.vercel-storage.com:5432/verceldb?sslmode=require

# Daglig agentjobb (HH:MM, lokal tid på serveren)
# DAILY_JOB_TIME=08:00

# Hemmelig nøkkel for JWT-tokens (login). Hvis den mangler, brukes API_TOKEN.
# JWT_SECRET=

# GitHub-token. Trengs for at agenten kan klone PRIVATE repoer fra serveren.
# Lag en fine-grained PAT med "Contents: Read" og legg den inn her.
# Uten den feiler kloning av private repoer med "Repository not found".
# GITHUB_TOKEN=github_pat_xxx

# Opcional: escuchar SOLO en la IP de Tailscale (mas seguro)
# HOST=100.x.y.z
# PORT=8000
