# ------------------------------------------------------------------
# Plantilla. Copiar a ".env" en la maquina nueva y rellenar.
# El .env real NUNCA se sube a GitHub (esta en .gitignore).
#   cp backend/.env.example backend/.env
# ------------------------------------------------------------------

# Clave compartida entre la app Android y el servidor.
# La app la envia en la cabecera "X-API-Token".
# Generar una nueva con:  openssl rand -hex 32
API_TOKEN=

# Gemini -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelos separados por coma, en orden de intento
# GEMINI_MODELS=gemini-flash-latest,gemini-3-flash-preview

# DeepSeek -> https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Vercel Postgres (minne, jobber og samtalehistorikk for agenten)
# Hvis denne mangler, faller serveren tilbake til lokal SQLite (backend/data/memory.db).
# DATABASE_URL=postgres://default:xxx@ep-xxx.vercel-storage.com:5432/verceldb?sslmode=require

# Daglig agentjobb (HH:MM, lokal tid på serveren)
# DAILY_JOB_TIME=08:00

# Hemmelig nøkkel for JWT-tokens (login). Hvis den mangler, brukes API_TOKEN.
# JWT_SECRET=

# GitHub-token. Trengs for at agenten kan klone PRIVATE repoer fra serveren.
# Lag en fine-grained PAT med "Contents: Read" og legg den inn her.
# Uten den feiler kloning av private repoer med "Repository not found".
# GITHUB_TOKEN=github_pat_xxx

# Opcional: escuchar SOLO en la IP de Tailscale (mas seguro)
# HOST=100.x.y.z
# PORT=8000
